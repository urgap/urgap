{
    "description": "user and password are pointing to the ENV variables that contain the actual data. host and schema are required for urgap lookup",
    "credentials": [
        {
            "description": "gcs-libcloud using libcloud does not need host yet schema+host is used for internal lookups",
            "scheme": "gcs-libcloud",
            "host": "gsk-rd-ngs-sbx",
            "user": "U_GCS_USER",
            "password": "U_GCS_PASSWORD",
            "secure": true,
            "secret_store": "gcp",
            "cloud_host_pid": "gsk-rd-ngs-sbx",
            "base_url": "gcs-libcloud://gsk-rd-ngs-sbx"
        },
        {
            "description": "github token https raw, here user=password will be formatted into the query",
            "scheme": "https",
            "host": "raw.githubusercontent.com",
            "user": "U_GITHUB_GSK_USER",
            "password": "U_GITHUB_GSK_PASSWORD",
            "secure": true,
            "secret_store": "env",
            "base_url": "https://raw.githubusercontent.com"
        },
        {
            "description": "local minio server",
            "scheme": "minio-libcloud",
            "host": "localhost:9000",
            "user": "U_MINIO_USER",
            "password": "U_MINIO_PASSWORD",
            "secure": false,
            "secret_store": "env",
            "base_url": "minio-libcloud://localhost:9000"
        }
    ]
}
