{
    "credentials": [
        {
            "description": "local mongodb",
            "scheme": "mongodb",
            "host": "localhost:27017",
            "user": "U_MONGODB_USER",
            "password": "U_MONGODB_PASSWORD",
            "secure": true,
        },
        {
            "description": "local ssh",
            "scheme": "ssh",
            "host": "localhost",
            "user": "ENV_VARIABLE_WITH_SSH_USER",
            "password": "ENV_VARIABLE_WITH_SSH_KEY",
            "secure": true,
        },
        {
            "description": "if project_id is defined, it will be used instead of host for GCP secret extraction",
            "scheme": "postgresql+pg8000",
            "host": "10.138.0.5:5432",
            "user": "U_GCS_SQL_USER",
            "password": "U_GCS_SQL_PASSWORD",
            "secure": true,
            "secret_store": "gcp",
        },
        {
            "description": "mylabdata interface",
            "scheme": "mylabdata",
            "host": "<mylabdata-files-api-url-without-https>",
            "user": "U_MYLABDATA_USER",
            "password": "U_MYLABDATA_PASSWORD",
            "secure": true,
        }
    ]