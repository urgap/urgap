{
    "description": "user and password are pointing to the ENV variables that contain the actual data. host and schema are required for urgap lookup",
    "credentials": [
        {
            "description": "github token https raw, here user=password will be formatted into the query",
            "scheme": "https",
            "host": "raw.githubusercontent.com",
            "user": "U_GITHUB_GSK_USER",
            "password": "U_GITHUB_GSK_PASSWORD",
            "secure": true,
            "secret_store": "env",
            "base_url": "https://raw.githubusercontent.com"
        },
        {
            "description": "local mongodb",
            "scheme": "mongodb",
            "host": "localhost:27017",
            "user": "U_MONGODB_USER",
            "password": "U_MONGODB_PASSWORD",
            "secure": true,
            "secret_store": "env",
            "base_url": "mongodb://localhost:27017"
        },
        {
            "description": "local ssh",
            "scheme": "ssh",
            "host": "localhost",
            "user": "ENV_VARIABLE_WITH_SSH_USER",
            "password": "ENV_VARIABLE_WITH_SSH_KEY",
            "secure": true,
            "secret_store": "env",
            "base_url": "ssh://localhost"
        },
        {
            "description": "if project_id is defined, it will be used instead of host for GCP secret extraction",
            "scheme": "postgresql+pg8000",
            "host": "10.138.0.5:5432",
            "user": "U_GCS_SQL_USER",
            "password": "U_GCS_SQL_PASSWORD",
            "secure": true,
            "secret_store": "gcp",
            "cloud_host_pid": "gsk-rd-ngs-dev",
            "base_url": "postgresql+pg8000://10.138.0.5:5432"
        },
        {
            "description": "mylabdata interface",
            "scheme": "mylabdata",
            "host": "<mylabdata-files-api-url-without-https>",
            "user": "U_MYLABDATA_USER",
            "password": "U_MYLABDATA_PASSWORD",
            "secure": true,
            "secret_store": "env",
            "base_url": "mylabdata://<mylabdata-files-api-url-without-https>"
        },
        {
            "description": "smb test interface",
            "scheme": "smb",
            "host": "10.0.20.165:445",
            "user": "U_SMB_TEST_USER",
            "password": "U_SMB_TEST_PASSWORD",
            "secure": true,
            "secret_store": "env",
            "base_url": "smb://10.0.20.165:445"
        },
        {
            "description": "OpenTelemetry Azure (dsoappinstprod). We store the connection string in password and user is just a dummy.",
            "scheme": "https",
            "host": "eastus2-3.in.applicationinsights.azure.com",
            "user": "U_AZ_INSIGHT_USER",
            "password": "U_AZ_INSIGHT_PASSWORD",
            "secure": true,
            "secret_store": "env",
            "base_url": "https://eastus2-3.in.applicationinsights.azure.com"
        }
    ]
}