FROM ghcr.io/astral-sh/uv:python3.12-bookworm

RUN addgroup --system nonroot && \
    adduser --system \
      --ingroup nonroot \
      --home /home/nonroot \
      nonroot

RUN mkdir -p "/home/urgap" && \
    chown -R nonroot:nonroot /home/urgap

ENV HOME=/home/nonroot
USER nonroot

# Add Urgap repo
WORKDIR /home/urgap
COPY dist/urgap-*.whl /tmp/
COPY pyproject.toml uv.lock /tmp/urgap-src/

# Install dependencies using uv
RUN uv venv urgap
ENV PATH="/home/urgap/urgap/bin:$PATH"
# Install the locked dependency set (reproducible), then the built wheel with
# --no-deps so the versioningit-stamped wheel is used without re-resolving deps.
RUN uv export --frozen --all-extras --no-emit-project --no-hashes \
      --project /tmp/urgap-src -o /tmp/requirements.txt && \
    uv pip install -r /tmp/requirements.txt --no-cache-dir && \
    uv pip install --no-deps --no-cache-dir $(find /tmp -name 'urgap-*.whl')

# Run checks
RUN python -c "import urgap; print(urgap.config)"
RUN uctl info version
